{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/consola",
      "destination": "/frontend/consola/index.html"
    },
    {
      "source": "/consola/",
      "destination": "/frontend/consola/index.html"
    },
    {
      "source": "/consola/(.*)",
      "destination": "/frontend/consola/$1"
    },
    {
      "source": "/",
      "destination": "/frontend/index.html"
    },
    {
      "source": "/((?!api/|frontend/).*)",
      "destination": "/frontend/$1"
    }
  ]
}
